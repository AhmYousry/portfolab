# Copy to apps/api/.env — never commit the real file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pb:pb_local_dev_only@localhost:5432/portfolio_builder
# Optional: non-pooled URL used only for `prisma migrate deploy` (scripts/migrate-deploy.mjs via
# `pnpm neon:migrate` and render-start). DATABASE_URL_UNPOOLED (Neon's standard name) is the fallback.
# Root .env / .env.local load after this file and override it (see /.env.example).
DIRECT_DATABASE_URL=
# password (default): email+password, reset email, optional social buttons.
# social: Google/GitHub only. Password endpoints are disabled and no mailer is configured.
#         Production refuses to start without at least one complete OAuth pair below.
AUTH_MODE=password
# Optional: serve the built web app from this API (single service). Relative to apps/api.
# e.g. ../web/dist — leave empty in dev (Vite serves the app and proxies /api).
WEB_DIST_DIR=
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used to build password-reset links).
APP_URL=http://localhost:5173
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-0123456789
SESSION_TTL_DAYS=7
# Absolute or repo-relative path to the content directory.
CONTENT_DIR=../../content
# Public HTTPS URL of THIS API (used for the Paymob notification/webhook URL).
API_PUBLIC_URL=

# ---- Product analytics (PostHog, server-side events) ----
# Project API key (phc_...). Server events are sent only for users who gave analytics consent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# First-party LeadEvent / WebhookEvent retention for `pnpm --filter @pb/api analytics:purge`.
ANALYTICS_RETENTION_DAYS=395

# ---- Password-reset email (Resend) ----
# console (default outside production): no email sent, dev prints the link. resend: real delivery.
# Production always uses resend and refuses to start without valid values below.
MAIL_PROVIDER=
# Sending-only API key from resend.com → API Keys (starts with re_). NEVER commit a real value.
RESEND_API_KEY=
# Sender on a domain VERIFIED in Resend (SPF + DKIM). resend.dev / example / .test senders are rejected in production.
# e.g. Portfolab <no-reply@mail.your-domain.com>
EMAIL_FROM=

# ---- Social sign-in (optional) ----
# Each pair is all-or-nothing: set both values or leave both empty. A half-set pair stops the API.
# Empty = that provider's button is hidden. Callbacks are derived from APP_URL (must be a bare origin):
#   http://localhost:5173/api/auth/oauth/google/callback
#   http://localhost:5173/api/auth/oauth/github/callback
# NEVER commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Payments (Paymob, Egypt, EGP) ----
# Master switch. Checkout also stays closed until Paymob is configured AND a Pro project is PUBLISHED.
CHECKOUT_ENABLED=false
PAYMOB_BASE_URL=https://accept.paymob.com
# Dashboard → Settings → Account Info / Developers. NEVER commit real values.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Legacy API key, only needed for `payments:reconcile` (transaction inquiry).
PAYMOB_API_KEY=
# Comma-separated integration IDs (test integrations while testing), e.g. 1234567,7654321
PAYMOB_INTEGRATION_IDS=
# Live keys (sk_live_/pk_live_) are refused unless this is true. Requires owner approval.
PAYMOB_ALLOW_LIVE=false
# Seed admin (local dev only). Leave empty to skip creating an admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
