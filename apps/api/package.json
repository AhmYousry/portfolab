{
  "name": "@pb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "content:import": "tsx --env-file-if-exists=.env src/scripts/import-content.ts",
    "make-admin": "tsx --env-file-if-exists=.env src/scripts/make-admin.ts",
    "payments:reconcile": "tsx --env-file-if-exists=.env src/scripts/reconcile-payments.ts",
    "analytics:purge": "tsx --env-file-if-exists=.env src/scripts/purge-analytics.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@pb/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "archiver": "7.0.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "gray-matter": "4.0.3",
    "helmet": "8.1.0",
    "posthog-node": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pb/config": "workspace:*",
    "@types/archiver": "6.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "22.19.0",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
