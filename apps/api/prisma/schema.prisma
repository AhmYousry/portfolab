generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Tier {
  FREE
  PRO
}

enum ContentStatus {
  DRAFT
  COMING_SOON
  PUBLISHED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  REJECTED
  FAILED
}

enum ResourceType {
  DOCUMENT
  PROMPTS
  CHECKLIST
  TEMPLATE
  REPO_ZIP
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  displayName      String
  locale           String    @default("ar")
  role             Role      @default(STUDENT)
  experienceLevel  String?
  weeklyHours      Int?
  goal             String?
  githubUrl        String?
  privacyAcceptedAt DateTime
  analyticsConsent Boolean   @default(false)
  analyticsConsentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  sessions            Session[]
  resetTokens         PasswordResetToken[]
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  checkpointProgress  CheckpointProgress[]
  purchases           Purchase[]
  entitlements        Entitlement[]
  leadEvents          LeadEvent[]
  auditLogs           AuditLog[]
  analyticsClaims     AnalyticsClaim[]
}

// One row per "this event may fire only once for this user + subject".
// Inserted atomically (primary key) before emitting; never purged by retention.
model AnalyticsClaim {
  event     String
  userId    String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([event, userId, subject])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  tagline        String        @default("")
  description    String
  level          String
  tier           Tier
  status         ContentStatus @default(DRAFT)
  estimatedHours String
  outcomes       String[]
  skills         String[]
  order          Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  modules     Module[]
  resources   Resource[]
  enrollments Enrollment[]

  @@index([status, order])
}

model Module {
  id          String        @id @default(cuid())
  projectId   String
  key         String
  title       String
  description String        @default("")
  order       Int
  status      ContentStatus @default(DRAFT)

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([projectId, key])
  @@index([projectId, order])
}

model Lesson {
  id              String        @id @default(cuid())
  moduleId        String
  slug            String
  title           String
  contentMarkdown String
  order           Int
  durationMinutes Int
  isPreview       Boolean       @default(false)
  publishedAt     DateTime?
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
  progress    LessonProgress[]
  resources   Resource[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
}

model Checkpoint {
  id           String @id @default(cuid())
  lessonId     String
  key          String
  title        String
  instructions String
  order        Int

  lesson   Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress CheckpointProgress[]

  @@unique([lessonId, key])
  @@index([lessonId, order])
}

model Resource {
  id             String        @id @default(cuid())
  key            String        @unique
  projectId      String?
  lessonId       String?
  unlockLessonId String?
  title          String
  description    String        @default("")
  type           ResourceType
  storageKey     String
  tier           Tier
  status         ContentStatus @default(DRAFT)
  order          Int           @default(0)

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([userId, projectId])
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model CheckpointProgress {
  id           String         @id @default(cuid())
  userId       String
  checkpointId String
  status       ProgressStatus
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([userId, checkpointId])
  @@index([userId])
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  provider        String
  providerOrderId String?        @unique
  status          PurchaseStatus @default(PENDING)
  amountMinor     Int
  currency        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  paidAt          DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  failureReason   String?
  intentionId     String?
  providerTransactionId String?
  analyticsCapturedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  entitlements Entitlement[]

  @@index([status])
  @@index([userId])
}

model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  tier       Tier
  purchaseId String?
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId, tier])
}

model WebhookEvent {
  id               String        @id @default(cuid())
  provider         String
  providerEventId  String
  payloadDigest    String
  processedAt      DateTime?
  processingStatus WebhookStatus @default(RECEIVED)
  createdAt        DateTime      @default(now())

  @@unique([provider, providerEventId])
}

model LeadEvent {
  id          String   @id @default(cuid())
  event       String
  anonymousId String?
  userId      String?
  path        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([utmCampaign])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  objectType String
  objectId   String
  detail     Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([objectType, objectId])
  @@index([createdAt])
}
