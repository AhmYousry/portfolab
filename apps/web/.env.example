# Copy to apps/web/.env.local. These values are PUBLIC (shipped to the browser).
# PostHog project API key (starts with phc_). Leave empty to disable PostHog entirely.
VITE_POSTHOG_KEY=
# EU cloud: https://eu.i.posthog.com  ·  US cloud: https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Session replay also requires the visitor's explicit opt-in in the consent banner.
VITE_POSTHOG_REPLAY_ENABLED=false
