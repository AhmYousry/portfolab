# Copy to apps/web/.env.local. These values are PUBLIC (shipped to the browser).
# PostHog project API key (starts with phc_).
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=your_posthog_host
# Session replay also requires the visitor's explicit opt-in in the consent banner.
VITE_POSTHOG_REPLAY_ENABLED=false
