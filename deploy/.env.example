# Copy to deploy/.env on the VPS (chmod 600). Never commit the real file.
# Empty required values make `docker compose` refuse to start, on purpose.

# ---- Site ----
SITE_DOMAIN=portfolab.blog

# ---- PostgreSQL (internal network only, never published) ----
POSTGRES_USER=portfolab
# URL-safe only. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=portfolab

# ---- API ----
# 32+ chars. Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=7

# ---- Password-reset email (Resend, required in production) ----
# Sending-only key from resend.com (starts with re_).
RESEND_API_KEY=
# Sender on a domain VERIFIED in Resend (SPF + DKIM green). Owner must choose the address.
# Format: Portfolab <address@your-verified-sending-domain>
EMAIL_FROM=

# ---- Optional social sign-in — provider hidden when its pair is empty ----
# Set BOTH values of a pair or neither (a half-set pair stops the API). See RUNBOOK.md §7.
# Callbacks: https://portfolab.blog/api/auth/oauth/google/callback
#            https://portfolab.blog/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Payments ----
# Checkout is hard-disabled in deploy/compose.yml (CHECKOUT_ENABLED=false). No Paymob keys here.

# ---- Optional product analytics (PostHog) — off when empty ----
# Server-side events (only for users who consented).
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_RETENTION_DAYS=395
# Browser SDK, baked in at image build time. Empty = no PostHog in the browser.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Free public beta build toggle ----
VITE_FREE_LAUNCH=true
