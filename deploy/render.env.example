# Render Free + Neon Free — reference list of environment variables (placeholders only).
# Enter real values ONLY in the Render dashboard (Environment tab). Never commit real values.
# render.yaml already sets: NODE_VERSION, NODE_ENV, AUTH_MODE=neon, WEB_DIST_DIR, CONTENT_DIR,
# CHECKOUT_ENABLED=false, CHECKPOINT_DISABLE, SESSION_TTL_DAYS, SESSION_SECRET (generated),
# VITE_FREE_LAUNCH=true, VITE_POSTHOG_REPLAY_ENABLED=false.

# ---- Neon (copy both from Neon → Connect → Prisma) ----
# Pooled connection (host contains "-pooler"), used by the running app.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&connect_timeout=15
# Direct (non-pooled) connection, used only by `prisma migrate deploy` at start.
# DATABASE_URL_UNPOOLED (the name `neon init` writes) is accepted as a fallback alias.
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&connect_timeout=15

# ---- Neon Auth email/password (default: AUTH_MODE=neon) ----
# Required. Public Auth URL from Neon Auth on the SAME branch as DATABASE_URL (not a secret).
# Missing or non-https stops the service on purpose.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
# Optional overrides — leave unset unless a real token carries different values.
# Defaults: JWKS at <Auth URL>/.well-known/jwks.json; issuer/audience = Auth URL or its origin.
# NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
# NEON_AUTH_JWT_ISSUER=<exact iss>
# NEON_AUTH_JWT_AUDIENCE=<exact aud, comma-separated>
# Set to true only if email verification is turned on in Neon Auth.
# NEON_AUTH_REQUIRE_EMAIL_VERIFIED=false

# ---- Optional legacy: Google/GitHub sign-in (AUTH_MODE=social only) ----
# Ignored in neon mode; leave empty. Only if you switch AUTH_MODE=social in the dashboard
# (at least ONE complete pair is then required). Callback URLs:
#   https://<service>.onrender.com/api/auth/oauth/google/callback
#   https://<service>.onrender.com/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# GITHUB_CLIENT_ID=<github-oauth-app-client-id>
# GITHUB_CLIENT_SECRET=<github-oauth-app-client-secret>

# ---- Optional overrides (normally leave unset) ----
# APP_URL and CORS_ORIGINS default to Render's RENDER_EXTERNAL_URL. Set both only for a custom domain.
# APP_URL=https://<your-custom-domain>
# CORS_ORIGINS=https://<your-custom-domain>

# ---- Not used in this mode ----
# MAIL_PROVIDER / RESEND_API_KEY / EMAIL_FROM: not used by Portfolab in neon/social mode.
# POSTHOG_API_KEY / VITE_POSTHOG_KEY: leave unset; analytics stays off.
